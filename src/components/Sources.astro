---
interface Props {
  sources: { title: string; url: string }[];
}
const { sources } = Astro.props;
---

{
  sources.length > 0 && (
    <section class="sources" aria-labelledby="sources-h">
      <h2 id="sources-h">Sources</h2>
      <ul>
        {sources.map((s) => (
          <li><a href={s.url} rel="noopener noreferrer" target="_blank">{s.title}</a></li>
        ))}
      </ul>
      <p class="note">Figures vary by brand and test method; check your filament's datasheet.</p>
    </section>
  )
}
