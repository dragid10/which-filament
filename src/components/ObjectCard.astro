---
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';

interface Props {
  object: CollectionEntry<'objects'>;
}
const { object } = Astro.props;
const best = await getEntry(object.data.best);
---

<a class="obj-card panel" href={`/objects/${object.id}`}>
  <div class="obj-pick">
    <div>
      <p class="eyebrow">Best pick</p>
      <strong>{best?.data.title}</strong>
    </div>
  </div>
  <h3>{object.data.title}</h3>
  <p>{object.data.summary}</p>
</a>
