---
import { HOME_USE, HOME_USE_LEVELS, type HomeUseLevel } from '../data/homeUse';

interface Props {
  level: HomeUseLevel;
  note?: string;
  /** "badge" is the compact pill used on rows; "callout" is the full block for detail pages */
  variant?: 'badge' | 'callout';
}
const { level, note, variant = 'badge' } = Astro.props;
const h = HOME_USE[level];
---

{
  variant === 'badge' ? (
    <p class="home-badge" data-level={level} title={note ? `${h.description} ${note}` : h.description}>
      <span aria-hidden="true">{h.icon}</span> {h.label}
    </p>
  ) : (
    <aside class="home-callout" data-level={level} aria-label="Where you can print it">
      <p class="home-callout-head">
        <span class="home-icon" aria-hidden="true">{h.icon}</span>
        <strong>{h.label}</strong>
        {note && <span class="home-note">{note}</span>}
      </p>
      <details class="home-key">
        <summary>Key</summary>
        <ul>
          {HOME_USE_LEVELS.map((l) => <li data-level={l}><span aria-hidden="true">{HOME_USE[l].icon}</span> <strong>{HOME_USE[l].label}</strong>: {HOME_USE[l].description}</li>)}
        </ul>
        <p>A variant is marked individually only when it differs from the rest of its material.</p>
      </details>
    </aside>
  )
}
