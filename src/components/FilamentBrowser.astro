---
// Search + filters + sort + card/list grid for a set of filament variants.
import type { CollectionEntry } from 'astro:content';
import FilamentCard from './FilamentCard.astro';
import ViewToggle from './ViewToggle.astro';
import UseCaseGroups from './UseCaseGroups.astro';
import { USE_CASES } from '../data/useCases';

interface Props {
  filaments: CollectionEntry<'filaments'>[];
  materials: CollectionEntry<'materials'>[];
  /** Show a material filter (only useful when variants span several materials) */
  materialFilter?: boolean;
}
const { filaments, materials, materialFilter = false } = Astro.props;
const materialRank = (id: string) => materials.find((m) => m.id === id)?.data.order ?? 100;
const sorted = [...filaments].sort(
  (a, b) =>
    materialRank(a.data.material.id) - materialRank(b.data.material.id) ||
    a.data.order - b.data.order ||
    // no explicit order: shorter (plainer) names first
    a.data.title.length - b.data.title.length ||
    a.data.title.localeCompare(b.data.title),
);
const materialTitle = (id: string) => materials.find((m) => m.id === id)?.data.title ?? id;
// Only offer use-case filters that at least one variant is actually good for
const usedUseCases = USE_CASES.filter((u) => filaments.some((f) => (f.data.goodFor as string[]).includes(u.id)));
---

<div class="app browse">
  <aside class="side" aria-label="Search and filters">
    <details class="side-details" open data-side>
      <summary><span>Search &amp; filter</span> <span class="side-count" data-side-count></span></summary>
      <form class="side-body" role="search" data-controls onsubmit="return false">
        <label class="side-label" for="q">Search</label>
        <input id="q" class="search" type="search" placeholder="rapid, silk, outdoor…" autocomplete="off" data-q />

        {
          materialFilter && (
            <fieldset>
              <legend class="side-label">Material</legend>
              <ul class="chips side-list">
                {materials.map((m) => (
                  <li class="chip">
                    <label>
                      <input type="checkbox" value={m.id} data-material />
                      <span class="t">{m.data.title}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </fieldset>
          )
        }

        <p class="side-label" style="margin-bottom:0">Good for</p>
        <UseCaseGroups attr="data-good" useCases={usedUseCases} />

        <div>
          <label for="sort" class="side-label">Sort by</label>
          <select id="sort" class="sort" data-sort>
            <option value="order">Recommended order</option>
            <option value="name">Name</option>
            <option value="strength">Strongest</option>
            <option value="speed">Fastest to print</option>
            <option value="ease">Easiest to print</option>
            <option value="heat">Most heat resistant</option>
            <option value="finish">Best looking</option>
          </select>
        </div>

        <div class="side-actions">
          <button type="reset" class="btn-link" data-reset>Clear filters</button>
          <button type="button" class="btn-show" data-show-results>Show results</button>
        </div>
      </form>
    </details>
  </aside>

  <div class="main-col" id="results-top">
    <div class="toolbar-row">
      <p class="count" data-count role="status" aria-live="polite"></p>
      <ViewToggle />
    </div>
    <h2 class="sr-only">Results</h2>
    <ul class="grid" data-grid>
      {
        sorted.map((f) => (
          <li style="display:contents">
            <FilamentCard filament={f} materialTitle={materialTitle(f.data.material.id)} />
          </li>
        ))
      }
    </ul>
    <p class="empty" data-empty hidden>Nothing matches. Try removing a filter.</p>
  </div>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-controls]')!;
  const q = form.querySelector<HTMLInputElement>('[data-q]')!;
  const sort = form.querySelector<HTMLSelectElement>('[data-sort]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const items = [...grid.children] as HTMLElement[];
  const cardOf = (li: HTMLElement) => li.querySelector<HTMLElement>('[data-card]')!;

  const checked = (attr: string) =>
    [...form.querySelectorAll<HTMLInputElement>(`[${attr}]:checked`)].map((i) => i.value);

  // keep state in the URL so filtered views can be shared
  function readUrl() {
    const p = new URLSearchParams(location.search);
    q.value = p.get('q') ?? '';
    sort.value = p.get('sort') ?? 'order';
    for (const [attr, key] of [['data-material', 'material'], ['data-good', 'for']] as const) {
      const wanted = (p.get(key) ?? '').split(',');
      form.querySelectorAll<HTMLInputElement>(`[${attr}]`).forEach((i) => (i.checked = wanted.includes(i.value)));
    }
  }
  function writeUrl() {
    const p = new URLSearchParams();
    if (q.value.trim()) p.set('q', q.value.trim());
    if (sort.value !== 'order') p.set('sort', sort.value);
    const m = checked('data-material');
    const g = checked('data-good');
    if (m.length) p.set('material', m.join(','));
    if (g.length) p.set('for', g.join(','));
    const view = new URLSearchParams(location.search).get('view');
    if (view) p.set('view', view);
    const qs = p.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  function apply() {
    const terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
    const mats = checked('data-material');
    const goods = checked('data-good');
    let shown = 0;
    for (const li of items) {
      const c = cardOf(li);
      const ok =
        terms.every((t) => c.dataset.search!.includes(t)) &&
        (!mats.length || mats.includes(c.dataset.material!)) &&
        goods.every((g) => c.dataset.good!.split(',').includes(g));
      c.hidden = !ok;
      if (ok) shown++;
    }
    const key = sort.value;
    const rating = (li: HTMLElement) => JSON.parse(cardOf(li).dataset.ratings!)[key] as number;
    // `items` starts in recommended order (materials, then each material's own order), so ties keep that order
    const base = [...items];
    if (key === 'name') base.sort((a, b) => cardOf(a).dataset.title!.localeCompare(cardOf(b).dataset.title!));
    else if (key !== 'order') base.sort((a, b) => rating(b) - rating(a));
    base.forEach((li) => grid.append(li));
    count.textContent = `${shown} of ${items.length} shown`;
    empty.hidden = shown > 0;
    writeUrl();
  }

  // Sidebar behaviour: always open on wide screens, collapsible on narrow ones
  const side = document.querySelector<HTMLDetailsElement>('[data-side]')!;
  const sideCount = document.querySelector<HTMLElement>('[data-side-count]')!;
  const wide = window.matchMedia('(min-width: 900px)');
  wide.addEventListener('change', () => { side.open = wide.matches; });
  if (!wide.matches) side.open = false;
  function updateSideCount() {
    const n = checked('data-material').length + checked('data-good').length + (q.value.trim() ? 1 : 0);
    sideCount.textContent = n ? `${n} active` : '';
  }
  document.querySelector('[data-show-results]')!.addEventListener('click', () => {
    if (!wide.matches) side.open = false;
    document.getElementById('results-top')!.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  });

  form.addEventListener('input', () => { apply(); updateSideCount(); });
  form.addEventListener('reset', () => setTimeout(() => { apply(); updateSideCount(); }));
  readUrl();
  apply();
  updateSideCount();
</script>
