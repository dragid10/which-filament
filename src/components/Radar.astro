---
// A glanceable "shape" of a filament's seven ratings. Decorative: the rating list next to it holds the same data as text.
import { RATING_KEYS, type RatingKey } from '../data/useCases';

interface Props {
  ratings: Record<RatingKey, number>;
}
const { ratings } = Astro.props;

const SHORT: Record<RatingKey, string> = {
  strength: 'Strength',
  heat: 'Heat',
  flex: 'Flex',
  ease: 'Ease',
  speed: 'Speed',
  finish: 'Looks',
  durability: 'Durable',
};
const C = 130; // centre
const R = 70; // radius of the outer ring (value 5)
const LABEL_R = R + 20;
const n = RATING_KEYS.length;
const angle = (i: number) => -Math.PI / 2 + (i * 2 * Math.PI) / n;
const pt = (i: number, r: number) => [C + r * Math.cos(angle(i)), C + r * Math.sin(angle(i))] as const;
const ring = (level: number) => RATING_KEYS.map((_, i) => pt(i, (R * level) / 5).map((v) => v.toFixed(1)).join(',')).join(' ');
const shape = RATING_KEYS.map((k, i) => pt(i, (R * ratings[k]) / 5).map((v) => v.toFixed(1)).join(',')).join(' ');
const labels = RATING_KEYS.map((k, i) => {
  const [x, y] = pt(i, LABEL_R);
  const cos = Math.cos(angle(i));
  return { k, x, y, anchor: Math.abs(cos) < 0.2 ? 'middle' : cos > 0 ? 'start' : 'end' };
});
---

<svg class="radar" viewBox="0 0 260 260" aria-hidden="true" focusable="false">
  {[1, 2, 3, 4, 5].map((l) => <polygon points={ring(l)} class="radar-ring" />)}
  {RATING_KEYS.map((_, i) => <line x1={C} y1={C} x2={pt(i, R)[0]} y2={pt(i, R)[1]} class="radar-axis" />)}
  <polygon points={shape} class="radar-shape" />
  {RATING_KEYS.map((k, i) => <circle cx={pt(i, (R * ratings[k]) / 5)[0]} cy={pt(i, (R * ratings[k]) / 5)[1]} r="3.5" class="radar-dot" />)}
  {labels.map((l) => <text x={l.x} y={l.y} text-anchor={l.anchor} dominant-baseline="middle" class="radar-label">{SHORT[l.k]}</text>)}
</svg>
