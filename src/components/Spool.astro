---
interface Props {
  color: string;
  size?: number;
}
const { color, size = 120 } = Astro.props;
---

<svg
  class="spool"
  width={size}
  height={size}
  viewBox="0 0 120 120"
  role="img"
  aria-label="Filament spool illustration"
>
  <circle cx="60" cy="60" r="56" fill="var(--spool-flange)" />
  <circle cx="60" cy="60" r="46" fill={color} />
  <path d="M60 14a46 46 0 0 1 32.5 13.5" stroke="#fff" stroke-opacity=".35" stroke-width="5" fill="none" stroke-linecap="round" />
  <circle cx="60" cy="60" r="22" fill="var(--spool-flange)" />
  <circle cx="60" cy="60" r="11" fill="var(--bg)" />
  <circle cx="60" cy="60" r="46" fill="none" stroke="#000" stroke-opacity=".12" />
</svg>
