---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Swatch from '../../components/Swatch.astro';

const materials = (await getCollection('materials')).sort((a, b) => a.data.order - b.data.order);
const filaments = await getCollection('filaments');
---

<Base title="Materials" description="Start with the material (PLA, PETG, ABS, ASA, TPU), then explore its variants like rapid, plus, matte, and carbon fiber.">
  <div class="wrap">
    <section class="page-head"><div>
      <p class="eyebrow">Step 1 of 2</p>
      <h1>Materials</h1>
      <p class="lede">Each material has its own personality. Pick one to see its variants, such as rapid, plus, matte, and silk.</p>
    </div></section>
    <h2 class="sr-only">All materials</h2>
    <ul class="grid">
      {
        materials.map((m) => {
          const variants = filaments.filter((f) => f.data.material.id === m.id);
          return (
            <li style="display:contents">
              <a class="mat-card" href={`/materials/${m.id}`}>
                {m.data.image ? <img class="mat-img" src={m.data.image} alt="" loading="lazy" /> : null}
                <div class="mat-top">
                  <span class="mat-count">{variants.length} variants</span>
                  <h3 class="mat-name">{m.data.title}</h3>
                </div>
                <div class="mat-body">
                  <p class="eyebrow">{m.data.fullName}</p>
                  <p>{m.data.summary}</p>
                  <span class="swatches" aria-hidden="true">
                    {variants.map((v) => <Swatch color={v.data.color} />)}
                  </span>
                  <span class="mat-go">Open {m.data.title} →</span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
    <p style="margin-top:2rem">Know what you're looking for? <a href="/filaments">Search all variants</a>.</p>
  </div>
</Base>
