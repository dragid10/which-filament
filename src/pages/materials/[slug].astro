---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sources from '../../components/Sources.astro';
import FilamentBrowser from '../../components/FilamentBrowser.astro';

export async function getStaticPaths() {
  const materials = await getCollection('materials');
  const filaments = await getCollection('filaments');
  return materials.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, materials, variants: filaments.filter((f) => f.data.material.id === entry.id) },
  }));
}

const { entry, materials, variants } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={d.title} description={d.summary}>
  <div class="wrap">
    <p class="crumbs"><a href="/materials">Materials</a> › {d.title}</p>
    <section class:list={['page-head', { 'with-media': !!d.image }]}><div>
      <p class="eyebrow">{d.fullName}</p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
      {d.aliases.length > 0 && <p style="color:var(--muted)">Also called: {d.aliases.join(', ')}</p>}
    </div>
    {d.image && (
      <figure class="media" style="margin:0">
        <img src={d.image} alt={d.imageAlt ?? `${d.title} filament example`} />
        {d.imageCredit && <figcaption style="font-size:.75rem;color:var(--muted)">{d.imageCredit}</figcaption>}
      </figure>
    )}
    </section>

    <div class="cols">
      <section class="panel">
        <h2>Pros</h2>
        <ul class="pros" style="margin:0;padding-left:1.4em">{d.pros.map((p) => <li>{p}</li>)}</ul>
      </section>
      <section class="panel">
        <h2>Cons</h2>
        <ul class="cons" style="margin:0;padding-left:1.4em">{d.cons.map((p) => <li>{p}</li>)}</ul>
      </section>
      <section class="panel">
        <h2>Typical settings</h2>
        <dl class="kv">
          <dt>Nozzle</dt><dd>{d.settings.nozzle}</dd>
          <dt>Bed</dt><dd>{d.settings.bed}</dd>
          {d.settings.enclosure && <><dt>Enclosure</dt><dd>{d.settings.enclosure}</dd></>}
          {d.settings.drying && <><dt>Drying</dt><dd>{d.settings.drying}</dd></>}
        </dl>
      </section>
    </div>

    <article class="prose"><Content /></article>
    <Sources sources={d.sources} />

    <h2>{d.title} variants <span style="color:var(--muted);font-weight:500;font-size:1rem">({variants.length})</span></h2>
    <FilamentBrowser filaments={variants} materials={materials} />
  </div>
</Base>
