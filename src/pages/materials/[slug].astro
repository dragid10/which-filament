---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sources from '../../components/Sources.astro';
import HomeUse from '../../components/HomeUse.astro';
import FilamentBrowser from '../../components/FilamentBrowser.astro';

export async function getStaticPaths() {
  const materials = await getCollection('materials');
  const filaments = await getCollection('filaments');
  return materials.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, materials, variants: filaments.filter((f) => f.data.material.id === entry.id) },
  }));
}

const { entry, materials, variants } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={d.title} description={d.summary}>
  <div class="wrap">
    <p class="crumbs"><a href="/materials">Materials</a> › {d.title}</p>
    <header class="head-compact">
      <h1>{d.title} <span class="full">{d.fullName}</span></h1>
      <p class="lede">{d.summary}</p>
    </header>

    <HomeUse level={d.homeUse} note={d.homeNote} variant="callout" />

    <details class="about" open data-about>
      <summary><h2>About {d.title}</h2></summary>
      <div class="facts">
        <section class="panel">
          <h3>Overview</h3>
          <div class="prose-inline"><Content /></div>
        </section>
        <section class="panel">
          <h3>Pros</h3>
          <ul class="pros">{d.pros.map((p) => <li>{p}</li>)}</ul>
        </section>
        <section class="panel">
          <h3>Cons</h3>
          <ul class="cons">{d.cons.map((p) => <li>{p}</li>)}</ul>
        </section>
        <section class="panel">
          <h3>Typical settings</h3>
          <dl class="kv">
            <dt>Nozzle</dt><dd>{d.settings.nozzle}</dd>
            <dt>Bed</dt><dd>{d.settings.bed}</dd>
            {d.settings.enclosure && <><dt>Enclosure</dt><dd>{d.settings.enclosure}</dd></>}
            {d.settings.drying && <><dt>Drying</dt><dd>{d.settings.drying}</dd></>}
          </dl>
        </section>
      </div>
    </details>

    <h2 class="variants-h">{d.title} variants</h2>
    <FilamentBrowser filaments={variants} materials={materials} />
    <Sources sources={d.sources} />
  </div>
</Base>

<script>
  // "About" is always open on wide screens and collapsible on narrow ones
  const about = document.querySelector<HTMLDetailsElement>('[data-about]')!;
  const wide = window.matchMedia('(min-width: 900px)');
  if (!wide.matches) about.open = false;
  wide.addEventListener('change', () => { about.open = wide.matches; });
  about.addEventListener('toggle', () => { if (wide.matches && !about.open) about.open = true; });
</script>
