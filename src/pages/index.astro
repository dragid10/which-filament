---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FilamentCard from '../components/FilamentCard.astro';
import ViewToggle from '../components/ViewToggle.astro';
import ObjectCard from '../components/ObjectCard.astro';
import Swatch from '../components/Swatch.astro';
import { USE_CASES } from '../data/useCases';

const materials = (await getCollection('materials')).sort((a, b) => a.data.order - b.data.order);
const filaments = await getCollection('filaments');
const objects = (await getCollection('objects')).slice(0, 6);
const materialTitle = (id: string) => materials.find((m) => m.id === id)?.data.title ?? id;
const byColour = [...filaments].sort((a, b) => a.data.color.localeCompare(b.data.color));
---

<Base>
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">Filament guide for 3D printing</p>
      <h1>Which filament should I <em>use</em> for this print?</h1>
      <p class="lede">
        Tell us what you're making. We'll rank PLA, PETG, ABS, ASA, TPU, and their variants for the job, and explain why.
      </p>
      <div class="dots" aria-hidden="true">
        {byColour.map((f) => <span style={`background:${f.data.color}`} />)}
      </div>
    </section>

    <section class="finder" aria-labelledby="finder-h" data-finder>
      <div class="finder-body">
        <h2 id="finder-h">What are you printing?</h2>
        <p class="hint">Pick everything that applies.</p>
        <fieldset>
          <legend class="sr-only">Use cases</legend>
          <ul class="chips tiles">
            {
              USE_CASES.map((u) => (
                <li class="chip">
                  <label title={u.hint}>
                    <input type="checkbox" value={u.id} data-usecase />
                    <span class="t"><span class="emoji" aria-hidden="true">{u.emoji}</span><span>{u.label}<span class="sr-only">. {u.hint}</span></span></span>
                  </label>
                </li>
              ))
            }
          </ul>
        </fieldset>
        <p class="finder-status" role="status" aria-live="polite" data-status>
          Choose at least one to get a ranked shortlist.
        </p>
      </div>
    </section>

    <section data-categories>
      <h2>Browse by material</h2>
      <p class="lede">Start with the material, then pick a variant like rapid, plus, matte, or carbon fiber.</p>
      <ul class="grid">
        {
          materials.map((m) => {
            const variants = filaments.filter((f) => f.data.material.id === m.id);
            return (
              <li style="display:contents">
                <a class="mat-card" href={`/materials/${m.id}`}>
                  {m.data.image ? <img class="mat-img" src={m.data.image} alt="" loading="lazy" /> : null}
                  <div class="mat-top">
                    <span class="mat-count">{variants.length} variants</span>
                    <h3 class="mat-name">{m.data.title}</h3>
                  </div>
                  <div class="mat-body">
                    <p class="eyebrow">{m.data.fullName}</p>
                    <p>{m.data.summary}</p>
                    <span class="swatches" aria-hidden="true">
                      {variants.map((v) => <Swatch color={v.data.color} />)}
                    </span>
                    <span class="mat-go">Open {m.data.title} →</span>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section data-results hidden aria-label="Ranked results">
      <h2 class="sr-only">Ranked results</h2>
      <div class="toolbar"><ViewToggle /></div>
      <ul class="grid" data-grid>
        {
          filaments
            .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title))
            .map((f) => (
              <li style="display:contents">
                <FilamentCard filament={f} materialTitle={materialTitle(f.data.material.id)} />
              </li>
            ))
        }
      </ul>
    </section>

    <h2>Or see what people print</h2>
    <ul class="grid">
      {objects.map((o) => <li style="display:contents"><ObjectCard object={o} /></li>)}
    </ul>
    <p style="margin-top:1.5rem"><a href="/objects">See all examples →</a> · <a href="/filaments">Search all variants →</a></p>
  </div>
</Base>

<script>
  import { scoreFilament, VERDICT_LABEL } from '../scripts/finder';
  import { USE_CASES } from '../data/useCases';

  const boxes = [...document.querySelectorAll<HTMLInputElement>('[data-usecase]')];
  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const categories = document.querySelector<HTMLElement>('[data-categories]')!;
  const results = document.querySelector<HTMLElement>('[data-results]')!;
  const items = [...grid.children] as HTMLElement[];
  const original = [...items];

  function update() {
    const selected = boxes.filter((b) => b.checked).map((b) => b.value);
    if (!selected.length) {
      original.forEach((li) => grid.append(li));
      for (const card of grid.querySelectorAll<HTMLElement>('[data-card]')) {
        card.querySelector<HTMLElement>('[data-match]')!.hidden = true;
      }
      status.textContent = 'Choose at least one to get a ranked shortlist.';
      categories.hidden = false;
      results.hidden = true;
      return;
    }
    categories.hidden = true;
    results.hidden = false;
    const scored = items.map((li) => {
      const card = li.querySelector<HTMLElement>('[data-card]')!;
      const match = scoreFilament(
        {
          ratings: JSON.parse(card.dataset.ratings!),
          goodFor: (card.dataset.good ?? '').split(',').filter(Boolean),
          avoidFor: (card.dataset.avoid ?? '').split(',').filter(Boolean),
        },
        selected,
      );
      return { li, card, match };
    });
    scored.sort((a, b) => b.match.score - a.match.score);
    for (const { li, card, match } of scored) {
      grid.append(li);
      const box = card.querySelector<HTMLElement>('[data-match]')!;
      const verdict = box.querySelector<HTMLElement>('[data-verdict]')!;
      const list = box.querySelector<HTMLElement>('[data-reasons]')!;
      box.hidden = false;
      verdict.textContent = `${VERDICT_LABEL[match.verdict]} · ${match.score}`;
      verdict.dataset.v = match.verdict;
      list.replaceChildren(
        ...match.reasons.map((t) => Object.assign(document.createElement('li'), { textContent: t })),
        ...match.warnings.map((t) => Object.assign(document.createElement('li'), { textContent: t, className: 'warn' })),
      );
    }
    const labels = selected.map((id) => USE_CASES.find((u) => u.id === id)!.label.toLowerCase());
    const top = scored[0];
    status.textContent = `Best for ${labels.join(' + ')}: ${top.card.querySelector('h3')!.textContent}.`;
  }
  boxes.forEach((b) => b.addEventListener('change', update));
  update();
</script>
