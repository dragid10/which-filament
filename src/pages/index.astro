---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FilamentCard from '../components/FilamentCard.astro';
import ViewToggle from '../components/ViewToggle.astro';
import ObjectCard from '../components/ObjectCard.astro';
import UseCaseGroups from '../components/UseCaseGroups.astro';

const materials = (await getCollection('materials')).sort((a, b) => a.data.order - b.data.order);
const filaments = await getCollection('filaments');
const objects = (await getCollection('objects')).slice(0, 6);
const materialTitle = (id: string) => materials.find((m) => m.id === id)?.data.title ?? id;
---

<Base>
  <div class="wrap app">
    <aside class="side" aria-label="What are you printing?">
      <details class="side-details" open data-side>
        <summary><span>What are you printing?</span> <span class="side-count" data-side-count></span></summary>
        <div class="side-body">
          <h2 class="side-title" id="finder-h">What are you printing?</h2>
          <p class="side-hint">Pick everything that applies.</p>
          <UseCaseGroups attr="data-usecase" />
          <div class="side-actions">
            <button type="button" class="btn-link" data-clear>Clear selection</button>
            <button type="button" class="btn-show" data-show-results>Show results</button>
          </div>
        </div>
      </details>
    </aside>

    <div class="main-col" id="results-top">
      <h1 class="page-title">Which filament should I use for this print?</h1>
      <p class="finder-status" role="status" aria-live="polite" data-status>
        Choose at least one option to get a ranked shortlist, or browse by material.
      </p>

      <section data-categories>
        <h2>Browse by material</h2>
        <ul class="grid mats">
          {
            materials.map((m) => {
              const variants = filaments.filter((f) => f.data.material.id === m.id);
              return (
                <li style="display:contents">
                  <a class="mat-card" href={`/materials/${m.id}`}>
                    {m.data.image ? <img class="mat-img" src={m.data.image} alt="" loading="lazy" /> : null}
                    <div class="mat-top">
                      <h3 class="mat-name">{m.data.title}</h3>
                      <span class="mat-count">{variants.length} variants</span>
                    </div>
                    <div class="mat-body">
                      <p class="eyebrow">{m.data.fullName}</p>
                      <p>{m.data.summary}</p>
                      <span class="mat-go">Open {m.data.title} →</span>
                    </div>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </section>

      <section data-results hidden aria-label="Ranked results">
        <h2 class="sr-only">Ranked results</h2>
        <div class="toolbar"><ViewToggle /></div>
        <ul class="grid" data-grid>
          {
            filaments
              .sort(
                (a, b) =>
                  (materials.findIndex((m) => m.id === a.data.material.id) - materials.findIndex((m) => m.id === b.data.material.id)) ||
                  a.data.order - b.data.order,
              )
              .map((f) => (
                <li style="display:contents">
                  <FilamentCard filament={f} materialTitle={materialTitle(f.data.material.id)} />
                </li>
              ))
          }
        </ul>
        <div class="more-row"><button type="button" class="btn-more" data-show-more aria-expanded="false" hidden>Show more</button></div>
      </section>

      <h2>Or see what people print</h2>
      <ul class="grid">
        {objects.map((o) => <li style="display:contents"><ObjectCard object={o} /></li>)}
      </ul>
      <p style="margin-top:1.5rem"><a href="/objects">See all examples →</a> · <a href="/filaments">Search all variants →</a></p>
    </div>
  </div>
</Base>

<script>
  import { scoreFilament, VERDICT_LABEL } from '../scripts/finder';
  import { USE_CASES } from '../data/useCases';

  const boxes = [...document.querySelectorAll<HTMLInputElement>('[data-usecase]')];
  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const categories = document.querySelector<HTMLElement>('[data-categories]')!;
  const results = document.querySelector<HTMLElement>('[data-results]')!;
  const items = [...grid.children] as HTMLElement[];
  const original = [...items];
  const moreBtn = document.querySelector<HTMLButtonElement>('[data-show-more]')!;
  const MAX_TOP = 5; // show only the best few first; the rest sit behind "Show more"
  let expanded = false;

  function update() {
    const selected = boxes.filter((b) => b.checked).map((b) => b.value);
    if (!selected.length) {
      original.forEach((li) => grid.append(li));
      for (const card of grid.querySelectorAll<HTMLElement>('[data-card]')) {
        card.querySelector<HTMLElement>('[data-match]')!.hidden = true;
        card.hidden = false;
        card.classList.remove('top-pick');
        delete card.dataset.extra;
      }
      expanded = false;
      moreBtn.hidden = true;
      status.textContent = 'Choose at least one option to get a ranked shortlist, or browse by material.';
      categories.hidden = false;
      results.hidden = true;
      return;
    }
    categories.hidden = true;
    results.hidden = false;
    const scored = items.map((li) => {
      const card = li.querySelector<HTMLElement>('[data-card]')!;
      const match = scoreFilament(
        {
          ratings: JSON.parse(card.dataset.ratings!),
          goodFor: (card.dataset.good ?? '').split(',').filter(Boolean),
          avoidFor: (card.dataset.avoid ?? '').split(',').filter(Boolean),
        },
        selected,
      );
      return { li, card, match };
    });
    scored.sort((a, b) => b.match.score - a.match.score);
    for (const { li, card, match } of scored) {
      grid.append(li);
      const box = card.querySelector<HTMLElement>('[data-match]')!;
      const verdict = box.querySelector<HTMLElement>('[data-verdict]')!;
      const list = box.querySelector<HTMLElement>('[data-reasons]')!;
      box.hidden = false;
      verdict.textContent = `${VERDICT_LABEL[match.verdict]} · ${match.score}`;
      verdict.dataset.v = match.verdict;
      list.replaceChildren(
        ...match.reasons.map((t) => Object.assign(document.createElement('li'), { textContent: t })),
        ...match.warnings.map((t) => Object.assign(document.createElement('li'), { textContent: t, className: 'warn' })),
      );
    }
    // Hick's law: lead with the few that matter; the rest are one click away
    const good = scored.filter((s) => s.match.verdict === 'great' || s.match.verdict === 'good').length;
    const topCount = Math.max(3, Math.min(MAX_TOP, good));
    scored.forEach(({ card }, i) => {
      card.classList.toggle('top-pick', i === 0);
      if (i >= topCount) card.dataset.extra = '1';
      else delete card.dataset.extra;
      card.hidden = i >= topCount && !expanded;
    });
    const extra = scored.length - topCount;
    moreBtn.hidden = extra <= 0;
    moreBtn.textContent = expanded ? 'Show fewer' : `Show ${extra} more`;
    moreBtn.setAttribute('aria-expanded', String(expanded));
    const labels = selected.map((id) => USE_CASES.find((u) => u.id === id)!.label.toLowerCase());
    const top = scored[0];
    status.textContent = `Best for ${labels.join(' + ')}: ${top.card.querySelector('h3')!.textContent}. Showing the top ${topCount} of ${scored.length}.`;
  }
  boxes.forEach((b) => b.addEventListener('change', update));
  moreBtn.addEventListener('click', () => {
    expanded = !expanded;
    for (const card of grid.querySelectorAll<HTMLElement>('[data-card][data-extra]')) card.hidden = !expanded;
    const n = grid.querySelectorAll('[data-card][data-extra]').length;
    moreBtn.textContent = expanded ? 'Show fewer' : `Show ${n} more`;
    moreBtn.setAttribute('aria-expanded', String(expanded));
  });
  update();

  // Sidebar behaviour: keep options open on wide screens, collapsible on narrow ones
  const side = document.querySelector<HTMLDetailsElement>('[data-side]')!;
  const sideCount = document.querySelector<HTMLElement>('[data-side-count]')!;
  const wide = window.matchMedia('(min-width: 900px)');
  function syncSide() {
    if (wide.matches) side.open = true;
  }
  wide.addEventListener('change', () => {
    syncSide();
    if (!wide.matches) side.open = false;
  });
  if (!wide.matches) side.open = false;
  function updateCount() {
    const n = boxes.filter((b) => b.checked).length;
    sideCount.textContent = n ? `${n} selected` : '';
  }
  boxes.forEach((b) => b.addEventListener('change', updateCount));
  document.querySelector('[data-clear]')!.addEventListener('click', () => {
    boxes.forEach((b) => (b.checked = false));
    update();
    updateCount();
  });
  document.querySelector('[data-show-results]')!.addEventListener('click', () => {
    if (!wide.matches) side.open = false;
    document.getElementById('results-top')!.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  });
  updateCount();
</script>
