---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FilamentBrowser from '../../components/FilamentBrowser.astro';

const materials = (await getCollection('materials')).sort((a, b) => a.data.order - b.data.order);
const filaments = await getCollection('filaments');
---

<Base title="Search all variants" description="Search and filter every filament variant across PLA, PETG, and more.">
  <div class="wrap">
    <p class="crumbs"><a href="/materials">Materials</a> › All variants</p>
    <header class="head-compact">
      <h1>All variants</h1>
      <p class="lede">Every variant across every material. Search, filter, or <a href="/materials">start with the material</a>.</p>
    </header>
    <FilamentBrowser filaments={filaments} materials={materials} materialFilter />
  </div>
</Base>
