---
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = 'Not sure which 3D printer filament to use? Pick what you are printing and compare PLA, PETG, ABS, ASA, TPU, and their variants.' } = Astro.props;
const fullTitle = title ? `${title} · Which Filament` : 'Which Filament · Pick the right 3D printing filament';
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { href: '/', label: 'Find mine' },
  { href: '/objects', label: 'Examples' },
  { href: '/materials', label: 'Materials' },
  { href: '/contribute', label: 'Contribute' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// Filament and material pages both live under the "Materials" section
const isActive = (href: string) =>
  href === '/' ? path === '/' : href === '/materials' ? path.startsWith('/materials') || path.startsWith('/filaments') : path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Apply a saved theme before first paint to avoid a flash
      try {
        var t = localStorage.getItem('wf-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar-row">
        <a class="brand" href="/">
          <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true" focusable="false">
            <circle cx="17" cy="17" r="16" style="fill:var(--ink)" />
            <circle cx="17" cy="17" r="10" style="fill:var(--head-bg)" />
            <circle cx="17" cy="17" r="4.5" style="fill:var(--ink)" />
          </svg>
          <span>Which Filament</span>
        </a>
        <div class="head-tools">
        <nav aria-label="Main">
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false">
          <span class="ico" aria-hidden="true">🌙</span><span>Dark mode</span>
        </button>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          Ratings are general guidance for typical filament of each type. Brands vary, so check the manufacturer's
          settings. Spotted a mistake? <a href="/contribute">Help fix it.</a>
        </p>
        <p><strong>FDM</strong> (fused deposition modeling) is the common home 3D printer: it melts plastic filament and builds the part one thin layer at a time. Resin printers work differently and do not use these filaments.</p>
      </div>
    </footer>
      <script>
      const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
      const root = document.documentElement;
      const mq = window.matchMedia('(prefers-color-scheme: dark)');
      const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : mq.matches);
      function sync() {
        const dark = isDark();
        btn.setAttribute('aria-pressed', String(dark));
        btn.querySelector('.ico')!.textContent = dark ? '☀️' : '🌙';
      }
      btn.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('wf-theme', next); } catch { /* storage unavailable */ }
        sync();
      });
      mq.addEventListener('change', sync);
      sync();
    </script>
  </body>
</html>
